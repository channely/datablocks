# Public Mapbox token used by the GeoJSON view (mapbox-gl requires a public token).
# Create your own at https://account.mapbox.com/ and restrict it to your domain.
VITE_MAPBOX_TOKEN=

# Mapbox style URL used by the GeoJSON view.
VITE_MAPBOX_STYLE=

# Base URL for loading dependencies inside the Javascript block sandbox.
# Defaults to https://unpkg.com/
VITE_DEPENDENCY_CDN=

# Optional backend for the Google Sheets block. Leave empty to disable the block
# (the request will fail and log an error).
VITE_FUNCTIONS_ENDPOINT=
