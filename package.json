    "clsx": "^2.1.1",
    "codejar": "^5.0.0",
    "console-feed": "^3.8.0",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "dagre": "^0.8.5",
    "dompurify": "^3.4.18",
    "highlight.js": "^11.9.0",
    "localforage": "^1.10.0",
    "lodash-es": "^4.17.21",
    "lucide-react": "^1.74.0",
    "mapbox-gl": "^3.35.0",
    "nanoid": "^6.0.2",
    "papaparse": "^5.4.1",
    "prettier": "^3.10.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
